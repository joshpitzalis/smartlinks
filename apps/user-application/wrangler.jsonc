/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "user-application",
	"main": "worker/index.ts",
	"compatibility_date": "2025-06-17",
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/auth/*", "/trpc/*", "/click-socket"]
	},
	"observability": {
		"enabled": true
	},
	"env": {
		"staging": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_id": "6f4d0685-cada-4b0d-90e1-5dcebcc9ac65",
					"remote": true
				}
			],
			"services": [
				{
					"binding": "BACKEND_SERVICE",
					"service": "data-service-staging",
					"remote": true
				}
			]
		},
		"production": {
			"routes": [
				{
					"custom_domain": true,
					"pattern": "ifnot.work"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_id": "f3b2bf85-0e3c-4424-a46b-97ca93b5da6f"
				}
			],
			"services": [
				{
					"binding": "BACKEND_SERVICE",
					"service": "data-service"
				}
			]
		}
	}
}
