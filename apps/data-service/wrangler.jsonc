/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "data-service",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-17",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"browser": {
		"binding": "VIRTUAL_BROWSER"
	},
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "6f4d0685-cada-4b0d-90e1-5dcebcc9ac65",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "smartlinks-eval-staging"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "dd1cfaabfc8c413faf01cb0ea8a69201",
			"remote": true
		}
	],
	"workflows": [
		{
			"binding": "DESTINATION_EVALUATION_WORKFLOW",
			"name": "destination-evaluation-workflow",
			"class_name": "DestinationEvaluationWorkflow"
		}
	],
	"queues": {
		"consumers": [
			{
				"queue": "smartlinks-data-queue-staging",
				"dead_letter_queue": "smartlinks-dead-letter-staging"
			}
		],
		"producers": [
			{
				"binding": "QUEUE",
				"queue": "smartlinks-data-queue-staging"
			}
		]
	}
}
